{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/about", "destination": "/pages/about.html" },
    { "source": "/rooms", "destination": "/pages/rooms.html" },
    { "source": "/services", "destination": "/pages/services.html" },
    { "source": "/booking", "destination": "/pages/booking.html" },
    { "source": "/contact", "destination": "/pages/contact.html" },
    { "source": "/admin", "destination": "/admin-login.html" },
    { "source": "/dashboard", "destination": "/admin-dashboard.html" }
  ]
}
